{
    "$schema": "https://opencode.ai/config.json",
    "instructions": [
        "/etc/opencode/AGENTS.md",
        "/etc/opencode/rules/*.md"
    ],
    "plugins": [
        "/etc/opencode/plugins/osc52"
    ],
    "providers": {
        "openrouter": {
            "models": {
                "deepseek/deepseek-v4.1-flash": {
                    "body": {
                        "provider": {
                            "order": ["together", "coreweave"],
                            "allow_fallbacks": true
                        }
                    }
                }
            }
        }
    }
}
